# Supabase — prefer new publishable + secret keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Required for browser / SSR clients (same URL + publishable values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Site / WhatsApp (E.164 digits only, no +)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=971500000000
NEXT_PUBLIC_PHONE_DISPLAY=+971 50 000 0000
NEXT_PUBLIC_EMAIL=info@instabizweb.com
NEXT_PUBLIC_ADDRESS=Downtown Dubai, United Arab Emirates
NEXT_PUBLIC_MAPS_URL=https://maps.google.com/?q=Downtown+Dubai

# Social (optional)
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/

# Seed admin (used by seed script only)
ADMIN_EMAIL=admin@teddypups.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=TeddyPups Admin
